# For a physical device, use your computer's LAN URL, for example http://192.168.1.10:8080.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google OAuth client IDs. The ID token audience must be accepted by the API's GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
