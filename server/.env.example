PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=finlo
DB_SSL_MODE=disable

JWT_ACCESS_SECRET=local-access-secret-change-me-000000000000
JWT_REFRESH_SECRET=local-refresh-secret-change-me-00000000000
JWT_ISSUER=finlo-api
JWT_AUDIENCE=finlo-app

# Web refresh-token cookie. Production HTTPS deployments should use true.
AUTH_COOKIE_SECURE=false
# Use lax/strict for same-site deployments. Cross-site HTTPS APIs require none and Secure=true.
AUTH_COOKIE_SAME_SITE=lax
# Usually blank. Set only when deliberately sharing cookies across subdomains.
AUTH_COOKIE_DOMAIN=

# Backward-compatible single Google OAuth client ID.
GOOGLE_CLIENT_ID=

# Comma-separated web, iOS, and Android client IDs. Overrides GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_IDS=

# Comma-separated browser origins. Native mobile clients are not subject to CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
